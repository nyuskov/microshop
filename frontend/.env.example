# Ключ Giphy API для панели GIF (получить на https://developers.giphy.com/dashboard/)
# Скопируйте этот файл в frontend/.env и вставьте ключ, затем перезапустите frontend.
VITE_GIPHY_API_KEY=

# (необязательно) Origin бэкенда. Если не задан — берётся https://<host>:8000.
# Полезно при запуске фронта отдельно от бэкенда или через nginx-прокси.
VITE_API_ORIGIN=https://localhost:8000
