# Ключ Giphy API для панели GIF (получить на https://developers.giphy.com/dashboard/)
# Скопируйте этот файл в frontend/.env и вставьте ключ, затем перезапустите frontend.
VITE_GIPHY_API_KEY=

# Origin бэкенда. Пусто/не задан = фронт ходит на тот же origin (vite-proxy
# или nginx проксируют /api, /media и WS на бэкенд) — так работает и с LAN
# (например, с телефона: https://192.168.0.15:5173). Если фронт раздаётся
# отдельно от бэкенда — укажите явно, например: https://localhost:8000
VITE_API_ORIGIN=

# (необязательно) JSON-массив ICE-серверов WebRTC (STUN/TURN). По умолчанию —
# публичные STUN Google. Для звонков за «симметричным» NAT добавьте TURN
# (см. docs/turn.md). Пример:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"microshop","credential":"secret"}]
VITE_ICE_SERVERS=

