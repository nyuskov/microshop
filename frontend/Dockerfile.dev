FROM node:20-alpine

# Устанавливаем pnpm
RUN npm install -g pnpm

WORKDIR /app

# Копируем package.json, pnpm-lock.yaml и .pnpmfile.cjs для кеширования слоя и настройки
COPY package*.json ./
COPY pnpm-lock.yaml ./
COPY .pnpmfile.cjs ./

# Создаем .npmrc для игнорирования скриптов сборки
RUN echo "ignore-scripts=true" > .npmrc && \
    echo "enable-pre-post-scripts=false" >> .npmrc

# Устанавливаем зависимости с помощью pnpm
# Используем --ignore-scripts для предотвращения ошибок
RUN pnpm install --frozen-lockfile --ignore-scripts

# Копируем исходный код (это будет переопределено volume в compose)
COPY . .

EXPOSE 5173

# Запускаем shell-скрипт, который обновляет зависимости и затем запускает vite
# Используем --ignore-scripts при повторной установке
CMD ["sh", "-c", "pnpm install --frozen-lockfile --ignore-scripts && pnpm exec vite --host --port 5173"]