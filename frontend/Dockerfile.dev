FROM node:20-alpine

# Устанавливаем pnpm
RUN npm install -g pnpm

WORKDIR /app

# Копируем package.json и pnpm-lock.yaml для кеширования слоя
COPY package*.json ./
COPY pnpm-lock.yaml ./

# Устанавливаем зависимости с помощью pnpm
# Это создает node_modules в образе, но они будут перезаписаны при монтировании volume
RUN pnpm install

# Копируем исходный код (это будет переопределено volume в compose)
# Это также копирует vite.config.ts в образ
COPY . .

EXPOSE 5173

# Запускаем shell-скрипт, который обновляет зависимости и затем запускает vite
# pnpm install быстрее и надежнее устанавливает зависимости строго по pnpm-lock.yaml
CMD ["sh", "-c", "pnpm install --frozen-lockfile && pnpm exec vite --host --port 5173"]