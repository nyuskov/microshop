{
  "name": "pismo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Pismo — веб-мессенджер (Vue 3 + Quasar)",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "typegen": "openapi-typescript ../backend/openapi.json -o src/types/generated.ts",
    "typegen:dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-typescript https://localhost:8000/openapi.json -o src/types/generated.ts",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.18",
    "axios": "^1.6.0",
    "pinia": "^3.0.4",
    "quasar": "^2.18.0",
    "vite-plugin-checker": "^0.10.3",
    "vue": "^3.5.18",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.93.2",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.6",
    "vite-plugin-mkcert": "^1.17.8",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  }
}
