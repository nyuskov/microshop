# Сборка статики фронтенда: vite build -> /usr/share/nginx/html.
#
# Этот образ НЕ раздаёт файлы. Он нужен как «поставщик» статики: во время деплоя
# контейнер из него копирует содержимое в том frontend_html, из которого читает
# рабочий nginx (сервис frontend). Так обновление интерфейса не требует
# пересоздания контейнера — а значит деплой проходит без простоя.
#
# Смотри: scripts/ci/deploy_remote.sh, docker-compose.test.yaml (frontend-dist).

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
ENV CI=true
# pnpm-workspace.yaml обязателен при install: в нём `allowBuilds: true` для
# esbuild/vue-demi/@parcel/watcher. Без него pnpm >=10 блокирует их build-скрипты
# и падает с ERR_PNPM_IGNORED_BUILDS.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --no-frozen-lockfile
COPY . .
# Публичный origin API (тот же, что у nginx). Переопределяется через build-arg.
ARG VITE_API_ORIGIN=http://localhost
ENV VITE_API_ORIGIN=${VITE_API_ORIGIN}
# Ключ Giphy Vite читает из frontend/.env (этот файл входит в контекст сборки).
# ВАЖНО: не задаём VITE_GIPHY_API_KEY через ARG/ENV — пустое значение ENV
# перекрыло бы .env (Vite не перезаписывает существующие переменные окружения),
# и панель GIF не увидела бы ключ на сервере.
RUN pnpm run build-only
