# Сборка статики фронтенда и «поставщик» файлов для тома frontend_html.
#
# Этот образ НЕ раздаёт файлы. Во время деплоя контейнер из него копирует
# содержимое в том, из которого читает рабочий nginx (сервис frontend), поэтому
# обновление интерфейса не требует пересоздания nginx — деплой идёт без простоя.
#
# Смотри: frontend/copy-static.sh, docker-compose.prod.yaml (frontend-dist),
# scripts/ci/deploy_remote.sh.

# Этап 1 — сборка vite.
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
ENV CI=true
# pnpm-workspace.yaml обязателен при install: в нём `allowBuilds: true` для
# esbuild/vue-demi/@parcel/watcher. Без него pnpm >=10 блокирует их build-скрипты
# и падает с ERR_PNPM_IGNORED_BUILDS.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --no-frozen-lockfile
COPY . .
# Публичный origin API (тот же, что у nginx). Переопределяется через build-arg.
ARG VITE_API_ORIGIN=http://localhost
ENV VITE_API_ORIGIN=${VITE_API_ORIGIN}
# Ключ Giphy Vite читает из frontend/.env (этот файл входит в контекст сборки).
# ВАЖНО: не задаём VITE_GIPHY_API_KEY через ARG/ENV — пустое значение ENV
# перекрыло бы .env (Vite не перезаписывает существующие переменные окружения),
# и панель GIF не увидела бы ключ на сервере.
RUN pnpm run build-only

# Этап 2 — маленький образ только с файлами и скриптом копирования:
# node и зависимости для деплоя не нужны, а путь /usr/share/nginx/html намеренно
# совпадает с тем, из которого раздаёт nginx (иначе копирование шло бы «в никуда»).
FROM alpine:3.24
COPY --from=build /app/dist /usr/share/nginx/html
COPY copy-static.sh /copy-static.sh
ENTRYPOINT ["/bin/sh", "/copy-static.sh"]
