# nginx прода: раздаёт статику фронтенда и проксирует /api и /media на backend.
#
# Статика лежит НЕ в образе, а в томе frontend_html (см. docker-compose.test.yaml):
# деплой обновляет файлы в томе, поэтому контейнер не пересоздаётся и сайт не
# пропадает. Образ меняется только при правке этого файла или nginx.prod.conf.

FROM nginx:1.27-alpine
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
# Каталог статики: его закрывает том. Пустой на случай, если том ещё не заполнен —
# тогда отдаём понятную заглушку вместо 403.
RUN mkdir -p /usr/share/nginx/html && \
    printf '<!doctype html><meta charset="utf-8"><title>Pismo</title><p>Обновление… Попробуйте через минуту.' \
      > /usr/share/nginx/html/index.html
EXPOSE 80
