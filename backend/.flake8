[flake8]
max-line-length = 88
extend-ignore = E203, W503
per-file-ignores =
    alembic/versions/*.py:E501
    ; Каталог переводов: ключ — цельная фраза с подстановками. Резать её или
    ; перевод переносом нельзя (текст уходит человеку как есть), поэтому длинные
    ; строки здесь — норма, а не нарушение стиля.
    core/i18n_en.py:E501
    ; Фикстура `api` импортируется из тестов мессенджера, а параметры тестов
    ; называются так же — это ложное срабатывание F811 (переопределение).
    tests/test_channels_api.py:F811