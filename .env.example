# Пример локального окружения для docker compose (и backend).
#
# Скопируйте в .env и задайте СВОИ значения, НЕ коммитьте .env:
#   cp .env.example .env
#
# Сгенерировать надёжный JWT_SECRET_KEY:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'

# Пароль пользователя postgres в контейнере БД.
# ВНИМАНИЕ: смена пароля требует пересоздания volume БД (./entry.sh или
# docker compose down -v), т.к. данные инициализируются при первом старте.
POSTGRES_PASSWORD=change-me-strong-password

# Секрет подписи JWT (HS256). Обязателен; никогда не оставляйте значение по умолчанию.
JWT_SECRET_KEY=change-me-64-hex-symbols

# (необязательно) Предыдущий секрет — для плановой ротации ключа без разлогина:
# токены подписываются текущим, а проверяются текущим и предыдущим. Держать
# не меньше 30 дней (срок жизни refresh-токена). Процедура: docs/jwt-rotation.md.
# JWT_SECRET_KEY_PREVIOUS=

# Учётка RabbitMQ (брокер Celery + мост realtime-событий).
# Гость (guest) из другого контейнера подключиться не может (RabbitMQ по
# умолчанию разрешает guest только с localhost), поэтому задаём свою пару.
RABBITMQ_USER=microshop
RABBITMQ_PASSWORD=change-me-rabbit-password

# (необязательно) Разрешённые CORS-источники (JSON-список). По умолчанию localhost:5173.
# CORS_ORIGINS=["https://localhost:5173","http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# Доставка OTP-кодов входа.
# Если ни один канал не настроен — код печатается в лог контейнера web
# (dev-режим): docker compose logs -f web | grep SMS-заглушка.
#
# 1) SMS Aero (ОСНОВНОЙ канал): https://smsaero.ru — коды входа.
#    Нужны: логин (email) аккаунта и API-ключ (кабинет → API: /cabinet/settings/apikey/).
#    Воркер сначала отправляет «код в Telegram» (≈2,5 ₽, с автооткатом на SMS),
#    и только потом обычное SMS (≈9 ₽) — отдельные настройки не нужны.
#    ⚠️ Без договора (ИП/ООО, кабинет → «Реквизиты и договоры») SMS Aero отклоняет
#    ВСЕ SMS: status=6, rejectReason «Необходимо заключить договор» (деньги не
#    списываются). Т.е. без договора работает только канал «код в Telegram».
SMS_AERO_EMAIL=
SMS_AERO_API_KEY=
# Подпись отправителя — обязательный параметр запроса к API. По умолчанию берётся
# бесплатная подпись «SMS Aero» (работает без регистрации, но тариф дороже: у
# некоторых операторов до 46 ₽ за SMS). Свою подпись регистрируют в кабинете;
# тариф авторизационных SMS (AUTH) — самый дешёвый для OTP.
# SMS_AERO_SIGN=SMS Aero
# 2) Telegram (дополнительно): Gateway и/или обычный бот. ВНИМАНИЕ: часть
#    хостингов (в т.ч. РФ) не имеет доступа к api.telegram.org — тогда эти
#    каналы не заработают (код уйдёт по SMS Aero или в лог).
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 3) E-mail (коды подтверждения адреса, вход без пароля, сброс пароля).
#    Нужен SMTP-аккаунт отправителя; для Gmail/Яндекса — «пароль приложения»,
#    а не пароль от почты. Пока SMTP_HOST/SMTP_FROM пусты — канал выключен:
#    экран входа не показывает «войти по e-mail», код идёт в лог воркера (dev).
#    Порт 587 со STARTTLS (по умолчанию) или 465 с SMTP_SSL=true.
SMTP_HOST=
# SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя (From) — обычно совпадает с SMTP_USER.
SMTP_FROM=
# SMTP_FROM_NAME=Pismo
# SMTP_STARTTLS=true
# SMTP_SSL=false
# Суточные лимиты отправки кодов (защита баланса SMS-шлюза; счётчики in-memory
# в процессе web, при рестарте сбрасываются). ESC 50/20 — значения по умолчанию.
# AUTH_OTP_DAILY_LIMIT=50
# AUTH_OTP_PER_IP_DAILY_LIMIT=20
# (необязательно) Базовые URL шлюзов, если они изменятся.
# SMS_AERO_BASE_URL=https://gate.smsaero.ru
# TELEGRAM_GATEWAY_BASE_URL=https://gateway.telegram.org

# ---------------------------------------------------------------------------
# Web Push уведомления (PWA): уведомления о новых сообщениях на телефоне,
# когда приложение закрыто (Android/Chrome). VAPID-ключи генерируются один раз:
#   python -c "from py_vapid import boto3 as x" (нет) — проще:
#   python -m venv /tmp/v && /tmp/v/bin/pip install py-vapid && \
#   /tmp/v/bin/vapid --gen
# Вписать сюда (private — ТОЛЬКО в .env, не в git!).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:nyuskov@gmail.com

# --- RuStore Push (Android-приложение из RuStore) ---
# Второй канал уведомлений: PWA получает Web Push, Android-обёртка — RuStore Push.
# Значения берутся в RuStore Консоль → Push-уведомления → Проекты и задаются
# в приложении при сборке (-PrustoreProjectId=...). Пока пусто — канал выключен.
RUSTORE_PUSH_PROJECT_ID=
RUSTORE_PUSH_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# TURN (релей медиа для звонков: нужен за «симметричным» NAT и в мобильных сетях)
# Креды выдаёт бэкенд временными (GET /api/v1/calls/ice-servers/), статического
# логина/пароля больше нет — секрет нужен и бэкенду, и coturn.
# TURN_URLS=turn:176.108.249.9:3478?transport=udp,turn:176.108.249.9:3478?transport=tcp
# TURN_SECRET=   # сгенерировать: openssl rand -hex 32
# TURN_REALM=pismo.space
# TURN_TTL_SECONDS=3600
# ВАЖНО: старые TURN_USERNAME/TURN_PASSWORD устарели — удалите их из .env и
# уберите turn:... из frontend/.env (Vite вшивает значения в бандл при сборке).

# ---------------------------------------------------------------------------
# Истории (статусы: фото/видео с подписью, живут 24 часа)
# Срок жизни одной публикации в часах. Меняется и на бэкенде (создание), и в
# выборке ленты, поэтому смена значения действует сразу и на новые, и на
# уже опубликованные истории (их expires_at пересчитывать не надо).
# STORY_TTL_HOURS=24

# Квота хранилища пользователя: в неё входят вложения чатов, аватары и истории.
# MEDIA_QUOTA_BYTES=524288000        # 500 МБ
# MEDIA_QUOTA_WARN_PERCENT=90        # предупреждение в UI
