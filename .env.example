# Пример локального окружения для docker compose (и backend).
#
# Скопируйте в .env и задайте СВОИ значения, НЕ коммитьте .env:
#   cp .env.example .env
#
# Сгенерировать надёжный JWT_SECRET_KEY:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'

# Пароль пользователя postgres в контейнере БД.
# ВНИМАНИЕ: смена пароля требует пересоздания volume БД (./entry.sh или
# docker compose down -v), т.к. данные инициализируются при первом старте.
POSTGRES_PASSWORD=change-me-strong-password

# Секрет подписи JWT (HS256). Обязателен; никогда не оставляйте значение по умолчанию.
JWT_SECRET_KEY=change-me-64-hex-symbols

# Учётка RabbitMQ (брокер Celery + мост realtime-событий).
# Гость (guest) из другого контейнера подключиться не может (RabbitMQ по
# умолчанию разрешает guest только с localhost), поэтому задаём свою пару.
RABBITMQ_USER=microshop
RABBITMQ_PASSWORD=change-me-rabbit-password

# (необязательно) Разрешённые CORS-источники (JSON-список). По умолчанию localhost:5173.
# CORS_ORIGINS=["https://localhost:5173","http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# Доставка OTP-кодов через Telegram.
# Если ни один токен не задан — код печатается в лог контейнера web (dev-режим).
#
# 1) Telegram Gateway (ОСНОВНОЙ канал; официальный SMS на телефон):
#    https://gateway.telegram.org — нужен токен приложения с доступом к Gateway.
TELEGRAM_GATEWAY_TOKEN=
# 2) Обычный Telegram-бот (РЕЗЕРВНЫЙ канал, 0 рублей): код приходит в личку
#    пользователю, который привязал свой Telegram к аккаунту.
#    Токен и username бота — из @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# (необязательно) Базовый URL Gateway, если он изменится.
# TELEGRAM_GATEWAY_BASE_URL=https://gateway.telegram.org

