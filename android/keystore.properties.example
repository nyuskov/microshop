# Настройки ключа подписи для сборки release (скопируйте в keystore.properties).
#
# Файл keystore.properties НЕ коммитится (см. .gitignore).
# Создать ключ: ./scripts/rustore/new_keystore.sh   (из корня репозитория)
#
# storeFile — путь относительно каталога android/
storeFile=keystore/pismo-release.jks
storePassword=ЗАМЕНИТЕ_НА_СВОЙ_ПАРОЛЬ
keyAlias=pismo
keyPassword=ЗАМЕНИТЕ_НА_СВОЙ_ПАРОЛЬ
