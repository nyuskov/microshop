<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тема оболочки: без ActionBar, тёмный фон, брендовый акцент.
         windowBackground = сплэш (логотип по центру тёмного фона) пока грузится WebView. -->
    <style name="Theme.Pismo" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:colorAccent">@color/pismo_brand</item>
        <item name="android:statusBarColor">@color/pismo_background</item>
        <item name="android:navigationBarColor">@color/pismo_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
